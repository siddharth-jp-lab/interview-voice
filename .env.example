# Copy this file to .env. setup.sh does that and fills SESSION_SECRET.
# Never commit .env.

# OpenAI key used by the token server, debrief, and topic research.
OPENAI_API_KEY=

# The only email allowed to sign in.
ALLOWED_EMAIL=

# Long password checked together with ALLOWED_EMAIL.
APP_PASSPHRASE=

# Random string used to keep session checks stable. setup.sh generates one.
SESSION_SECRET=

# Optional. Defaults to data/interview.db. On Fly this is /data/interview.db.
# DATABASE_PATH=data/interview.db
